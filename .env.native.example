# License API — NATIVE (no-Docker) environment. Copy to `.env.native` and fill in the password.
#
#   cp .env.native.example .env.native      (PowerShell: Copy-Item .env.native.example .env.native)
#
# `.env.native` is gitignored. This example file is committed and must never contain a real secret.
# Loaded by Node's built-in `--env-file` flag (Node >= 20.6), so no dotenv dependency is involved.
# See docs/native-setup.md for the full walkthrough and docs/config-reference.md for every setting.

# --- Non-secret runtime settings -------------------------------------------------------------------
NODE_ENV=production
# 127.0.0.1, not 0.0.0.0: a native process binds directly to the host, so there is no container boundary
# to keep it off the network. Use 0.0.0.0 only if you deliberately want it reachable from other machines.
HOST=127.0.0.1
# Auto-selected. `setup:native` picks the first usable port starting here, and `start:native` re-checks
# immediately before serving and relocates if it has since been taken (e.g. you brought `docker compose`
# up in between). A relocation is announced and written back to this file, so the admin-ui dev proxy
# follows it. Pin a value here if you like, but an occupied pin is still overridden rather than crashing.
PORT=8080
DB_POOL_MAX=10
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info

# Keep V8's heap tight. The service uses ~19 MB of heap in practice; without this, V8 sizes its heap from
# total system RAM, GCs lazily, and RSS drifts up. Mirrors the api service limit in docker-compose.yml.
NODE_OPTIONS=--max-old-space-size=192

# --- Database ---------------------------------------------------------------------------------------
# NOTE: `localhost`, NOT the `db` hostname used by docker-compose. This is the single most common
# copy-paste mistake when moving from the Docker path — `secrets/database_url` points at `db:5432`, which
# only resolves inside the compose network.
# Must match the role/database created by scripts/native/setup.(sh|ps1).
DATABASE_URL=postgres://licensesrv:CHANGE_ME@localhost:5432/licensesrv

# --- Secrets ----------------------------------------------------------------------------------------
# The app resolves <VAR>_FILE first (file contents, trailing newline trimmed), then falls back to <VAR>.
# We reuse the SAME files the Docker path uses, so secrets are generated once and shared by both paths —
# no duplication, and no secret values inside this env file. Paths are relative to the repo root, which is
# the working directory the npm scripts run from.
API_KEY_SECRET_FILE=./secrets/api_key_secret

# Unlocks the signer. Without it the signer stays locked and POST /admin/licenses returns
# 503 signer_unavailable. Generate once with: npx tsx scripts/gen-custody.ts
SIGNING_CUSTODIAN_SHARES_FILE=./secrets/custodian_shares

# --- Observability ----------------------------------------------------------------------------------
# Left EMPTY on purpose: empty disables tracing entirely, and the OTel SDK packages are then never even
# loaded (see the lazy-loading note at the top of src/server/observability/tracing.ts) — worth ~37 MB RSS.
# Set this to an OTLP/HTTP collector endpoint to turn tracing on.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OBS_TRACE_SAMPLE_RATIO=0.1
# OTEL_EXPORTER_OTLP_AUTH_TOKEN=

# OpenMetrics/Prometheus scrape listener on a dedicated port. Set to 0 to disable it entirely.
# Note the OBS_ prefix — the config key is `metricsPort` but the env var is OBS_METRICS_PORT.
# Also auto-selected at setup. The server already fails open if this port is taken (it logs and serves
# without /metrics), so picking a free one up front is what makes /metrics actually work.
OBS_METRICS_PORT=9464
